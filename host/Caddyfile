# Host reverse proxy (Caddyfile) — single LAN entrypoint for all services.
# Run with Caddy from nix (no apt):  caddy run --config host/Caddyfile --adapter caddyfile
# Or: nix run nixpkgs#caddy -- run --config host/Caddyfile --adapter caddyfile
#
# One LAN address, path-based routing: browsers just open the host IP, no
# /etc/hosts edits and no per-service DNS. Service prefixes first, docs
# catch-all last (keeps /collaboration websockets on docs).
#
# NOTE on subpaths: handle_path strips the prefix before proxying, so the
# backend sees /... as if served from root. This works as long as the app
# builds relative links; if a backend ever requires root hosting with
# absolute URLs, its block needs rewriting on the app side (FORCE_SCRIPT_NAME
# / sub-URL support) — not a proxy tweak.
#
# NOTE: bare-IP browser access needs the origin trusted by Django as well —
# booting the microVM via ./demo.sh (or manually with the env var) auto-exports
# SELFHOSTIX_PUBLIC_ORIGIN=http://<host-LAN-IP> for this (see host/detect-origin.sh).
{
	auto_https off
}

:80 {
	bind 0.0.0.0

	# --- Drive (reserved .11: enable when drive-microvm lands; 502 until then) ---
	handle_path /drive/* {
		reverse_proxy 192.168.100.11:80
	}

	# --- Grist (reserved .12: enable when grist-microvm lands; 502 until then) ---
	handle_path /grist/* {
		reverse_proxy 192.168.100.12:80
	}

	# --- Selfhostix docs (live): everything else -> guest. ---
	handle {
		reverse_proxy 192.168.100.10:80
	}
}
