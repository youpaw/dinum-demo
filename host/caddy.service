[Unit]
Description=Host reverse proxy (Caddy via nix, multi-service entrypoint)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# EDIT: point at your local checkout of this repo.
WorkingDirectory=%h/proj/dinum/demo
ExecStart=/nix/var/nix/profiles/default/bin/nix --extra-experimental-features 'nix-command flakes' run nixpkgs#caddy -- run --config host/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
